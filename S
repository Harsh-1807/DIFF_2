# Physics Guidance
# ════════════════════════════════════════════════════════════════════════════

class PhysicsGuide:
    DRY_THRESH_LOG = 0.01

    @staticmethod
    def apply(pred_log, coarse_log, enforce_mass=True, enforce_dry=True):
        pred = pred_log.clamp(min=0.)
        if enforce_dry:
            coarse_mean = coarse_log.mean(dim=[-2, -1], keepdim=True)
            dry_mask = coarse_mean < PhysicsGuide.DRY_THRESH_LOG
            pred = pred * (~dry_mask).float()
        if enforce_mass:
            pred_phys   = torch.expm1(pred.clamp(0))
            coarse_phys = torch.expm1(coarse_log.clamp(0))
            coarse_up   = F.interpolate(coarse_phys, size=pred.shape[-2:],
                                        mode='bilinear', align_corners=False)
            target_mean = coarse_up.mean(dim=[-2, -1], keepdim=True).clamp(1e-6)
            pred_mean   = pred_phys.mean(dim=[-2, -1], keepdim=True).clamp(1e-6)
            scale = (target_mean / pred_mean).clamp(0.1, 10.0)
            pred = torch.log1p((pred_phys * scale).clamp(0))
        return pred


# ════════════════════════════════════════════════════════════════════════════
# QDM
# ════════════════════════════════════════════════════════════════════════════

class QDM:
    def __init__(self, n_quantiles=1000, clip_min=0.):
        self.n = n_quantiles
        self.clip = clip_min
        self.q = torch.linspace(0., 1., n_quantiles)
        self.cm = self.co = None
        self._fitted = False

    def fit(self, mp, op):
        mp_flat = mp.flatten().float().cpu()
        op_flat = op.flatten().float().cpu()
        max_elements = 15000000
        if op_flat.numel() > max_elements:
            indices  = torch.randperm(op_flat.numel())[:max_elements]
            op_sampled = op_flat[indices]; mp_sampled = mp_flat[indices]
        else:
            op_sampled = op_flat; mp_sampled = mp_flat
        self.cm = torch.quantile(mp_sampled, self.q)
        self.co = torch.quantile(op_sampled, self.q)
        self._fitted = True
        i95 = int(.95 * self.n); i99 = int(.99 * self.n)
        print(f"[QDM] P95 model={self.cm[i95]:.2f} obs={self.co[i95]:.2f} | "
              f"P99 model={self.cm[i99]:.2f} obs={self.co[i99]:.2f}")

    @torch.no_grad()
    def apply(self, pred):
        assert self._fitted
        dev = pred.device
        cm  = self.cm.to(dev); co = self.co.to(dev)
        x   = pred.flatten().float()
        idx = torch.searchsorted(cm.contiguous(), x.contiguous()).clamp(0, self.n - 1)
        return (co[idx] * (x / cm[idx].clamp(1e-6)).clamp(0, 10)).clamp(self.clip) \
                   .reshape(pred.shape).to(pred.dtype)

    def save(self, p):
        torch.save({"cm": self.cm, "co": self.co, "n": self.n, "clip": self.clip}, p)

    @classmethod
    def load(cls, p):
        d = torch.load(p, map_location="cpu")
        q = cls(d["n"], d["clip"])
        q.cm = d["cm"]; q.co = d["co"]; q._fitted = True
        return q  import torch
import torch.nn.functional as F
import numpy as np
import xarray as xr
import warnings
import pandas as pd
from torch.utils.data import Dataset

warnings.filterwarnings("ignore")

class SEAUpscaleDataset(Dataset):
    """
    Dataset for SEA region handling 4 variables: Precipitation, TAS, HUSS, and MSLP.
    Dynamically downscales HR data to LR and applies variable-specific normalizations.
    """
    
    VAR_MAP = {
        "precip": ["pr", "precip", "rainfall", "tp"],
        "tas": ["tas", "t2m", "temperature"],
        "huss": ["huss", "q", "specific_humidity"],
        "mslp": ["psl", "msl", "mean_sea_level_pressure"]
    }

    def __init__(
        self,
        nc_files_dict,      # Dictionary of paths e.g., {"precip": "pr.nc", "tas": "tas.nc", ...}
        oro_file,           # Topography / Orography file
        downscale_factor=4,
        normalize=True,
        device="cuda",
        split='train',
        train_frac=0.70,
        t_cond=5,
    ):
        self.split = split
        self.downscale = downscale_factor
        self.t_cond = t_cond
        self.variables = ["precip", "tas", "huss", "mslp"]
        
        compute_device = (torch.device("cuda") 
                          if device == "cuda" and torch.cuda.is_available() 
                          else torch.device("cpu"))

        # ── 1. LOAD MULTIPLE VARIABLES ──────────────────────────────
        data_dict = {}
        time_coords = None
        
        for var_key in self.variables:
            if var_key not in nc_files_dict:
                raise ValueError(f"Missing file path for required variable: {var_key}")
                
            try:
                ds = xr.open_dataset(nc_files_dict[var_key], engine="netcdf4")
            except Exception:
                ds = xr.open_dataset(nc_files_dict[var_key], engine="h5netcdf")

            # Sort by Lat/Lon
            lat_name = next((c for c in ds.coords if c.lower() in ['lat', 'latitude', 'rlat']), None)
            lon_name = next((c for c in ds.coords if c.lower() in ['lon', 'longitude', 'rlon']), None)
            if lat_name and lon_name:
                ds = ds.sortby([lat_name, lon_name])

            # Auto-detect internal NetCDF variable name
            found_var = None
            for v in ds.data_vars:
                if any(k.lower() in v.lower() for k in self.VAR_MAP[var_key]):
                    found_var = v; break
            if found_var is None:
                # Fallback: pick first 2D+ data var
                for v in ds.data_vars:
                    if ds[v].values.squeeze().ndim >= 2:
                        found_var = v; break
            if found_var is None:
                found_var = list(ds.data_vars)[0]
                
            raw_data = ds[found_var].values.astype(np.float32)
            while raw_data.ndim > 3:
                raw_data = raw_data.squeeze(1)
            
            # Special handling for precipitation
            if var_key == "precip":
                raw_data = np.nan_to_num(raw_data, nan=0.0)
                raw_data = np.clip(raw_data, a_min=0.0, a_max=None)
            else:
                raw_data = np.nan_to_num(raw_data, nan=np.nanmean(raw_data))

            data_dict[var_key] = raw_data
            if time_coords is None:
                time_coords = ds.indexes.get('time', ds.indexes.get('Time'))

        # ── 2. CROP TO MULTIPLE OF 16 ───────────────────────────────
        T, H, W = data_dict["precip"].shape
        H_crop, W_crop = (H // 16) * 16, (W // 16) * 16
        self.H, self.W = H_crop, W_crop
        
        for k in data_dict:
            data_dict[k] = data_dict[k][:, :H_crop, :W_crop]

        # Stack into [T, C, H, W] tensor
        fine_stacked = np.stack([data_dict[v] for v in self.variables], axis=1)
        self.T = fine_stacked.shape[0]

        # Time information
        if time_coords is not None:
            dt = pd.to_datetime(time_coords.values)[:self.T]
            self.doy = torch.tensor(dt.dayofyear.values / 366.0, dtype=torch.float32)
            self.hour = torch.tensor(dt.hour.values / 24.0, dtype=torch.float32)
        else:
            self.doy = torch.zeros(self.T, dtype=torch.float32)
            self.hour = torch.zeros(self.T, dtype=torch.float32)

        # ── 3. LOAD & CROP TOPO ─────────────────────────────────────
        ds_oro = xr.open_dataset(oro_file, decode_times=False)

        # Skip scalar/0-d vars (e.g. rotated_pole); find first 2D variable
        orog_name = None
        for n in ds_oro.data_vars:
            arr = ds_oro[n].values.squeeze()
            if arr.ndim == 2:
                orog_name = n
                break
        if orog_name is None:
            raise ValueError(
                f"No 2D variable found in topo file: {oro_file}\n"
                f"Variables: { {n: ds_oro[n].shape for n in ds_oro.data_vars} }"
            )

        topo = ds_oro[orog_name].values.squeeze().astype(np.float32)  # (H, W)
        topo = np.nan_to_num(topo, nan=0.0)
        topo = topo[:H_crop, :W_crop]

        # ── 4. NORMALIZATION STATS (Train Split Based) ──────────────
        n_train = int(train_frac * self.T)
        self.mean, self.std = {}, {}
        
        if normalize:
            # Topo
            self.topo_mean = topo.mean()
            self.topo_std = topo.std() + 1e-8
            topo = (topo - self.topo_mean) / self.topo_std
            
            for i, v in enumerate(self.variables):
                if v == "precip":
                    # Precip: Log1p applied during precompute, NO z-score
                    self.mean[v], self.std[v] = 0.0, 1.0 
                else:
                    train_slice = fine_stacked[:n_train, i, :, :]
                    self.mean[v] = float(np.nanmean(train_slice))
                    self.std[v] = float(np.nanstd(train_slice) + 1e-8)
                    fine_stacked[:, i, :, :] = (fine_stacked[:, i, :, :] - self.mean[v]) / self.std[v]

        self.topo_tensor = torch.from_numpy(topo).unsqueeze(0).contiguous()

        # ── 5. PRECOMPUTE FINE / COARSE DYNAMICALLY ─────────────────
        fine_all, coarse_all = [], []
        
        print(f"Dataset Split      : {self.split}")
        print(f"Variables          : {self.variables}")
        print(f"Fine resolution    : {self.H}x{self.W}")
        print(f"Coarse resolution  : {self.H//downscale_factor}x{self.W//downscale_factor}")
        
        for i in range(0, self.T, 32):
            chunk = torch.from_numpy(fine_stacked[i:i+32])  # [B, C, H, W]
            if compute_device.type == "cuda":
                chunk = chunk.to(compute_device, non_blocking=True)
                
            coarse = F.avg_pool2d(chunk, kernel_size=self.downscale, stride=self.downscale)
            
            # Apply Log1p specifically to the Precipitation channel (index 0)
            if normalize:
                chunk[:, 0, :, :] = torch.log1p(chunk[:, 0, :, :])
                coarse[:, 0, :, :] = torch.log1p(coarse[:, 0, :, :])
                
            fine_all.append(chunk.cpu())
            coarse_all.append(coarse.cpu())

        self.fine = torch.cat(fine_all).contiguous()      # [T, 4, H, W]
        self.coarse = torch.cat(coarse_all).contiguous()  # [T, 4, H/4, W/4]
        
        # ── 6. VARIANCE MAP (On LR Precip) ──────────────────────────
        coarse_pr = self.coarse[:, 0].numpy()             # [T, H/4, W/4]
        var_map = np.var(coarse_pr[:n_train], axis=0)     # Computed on train split
        var_map = np.nan_to_num(var_map, nan=0.0)

        vmin, vmax = var_map.min(), var_map.max()
        if vmax - vmin > 1e-7:
            var_map = (var_map - vmin) / (vmax - vmin + 1e-8)
        else:
            var_map = np.zeros_like(var_map)

        self.var_map_tensor = torch.from_numpy(var_map).float().unsqueeze(0).contiguous()

        # ── 7. SPLIT INDEXING ───────────────────────────────────────
        n_val = int(0.10 * self.T)
        if split == 'train':
            self.idx = np.arange(self.t_cond, n_train)
        elif split == 'val':
            self.idx = np.arange(n_train, n_train + n_val)
        else:
            self.idx = np.arange(n_train + n_val, self.T)

    def __len__(self):
        return len(self.idx)

    def __getitem__(self, i):
        t = int(self.idx[i])

        out = {
            "fine": self.fine[t],
            "coarse": self.coarse[t],
            "topo": self.topo_tensor,
            "doy": self.doy[t],
            "hour": self.hour[t],
            "idx": torch.tensor(t, dtype=torch.long),
            "var_map": self.var_map_tensor,
        }

        # ===================== TEMPORAL FRAMES (LR) =====================
        if t >= self.t_cond - 1:
            start = t - self.t_cond + 1
            tc_frames = self.coarse[start:t+1]          # [T_COND, C, H/4, W/4]
        else:
            pad_len = self.t_cond - (t + 1)
            first = self.coarse[0].unsqueeze(0)
            pad = first.expand(pad_len, -1, -1, -1)
            current = self.coarse[0:t+1]
            tc_frames = torch.cat([pad, current], dim=0)
        
        out["tc_frames"] = tc_frames
        # ================================================================

        return out

    def denormalize_precip(self, data):
        """Denormalizes precipitation (reverses log1p)"""
        return torch.expm1(data)

    def denormalize_var(self, data, var_name):
        """Denormalizes TAS, HUSS, or MSLP"""
        if var_name == "precip":
            return self.denormalize_precip(data)
        return data * self.std[var_name] + self.mean[var_name] # -*- coding: utf-8 -*-
