def compute_slope_aspect(elev, global_elev_max=8600.0, global_slope_max=1.5):
    kx = torch.tensor([[-1, 0, 1], [-2, 0, 2], [-1, 0, 1]], dtype=torch.float32, device=elev.device).view(1, 1, 3, 3)
    ky = torch.tensor([[-1, -2, -1], [0, 0, 0], [1, 2, 1]], dtype=torch.float32, device=elev.device).view(1, 1, 3, 3)
    e = elev.float()
    dx = F.conv2d(e, kx, padding=1)
    dy = F.conv2d(e, ky, padding=1)
    slope = torch.sqrt(dx**2 + dy**2 + 1e-8)
    aspect = torch.atan2(dy, dx)
    
    def global_norm(t, g_min, g_max):
        return 2 * (t - g_min) / (g_max - g_min + 1e-8) - 1

    return torch.cat([global_norm(e, 0.0, global_elev_max), global_norm(slope, 0.0, global_slope_max), aspect / math.pi], dim=1)

def expand_topo(topo_1ch):
    return torch.cat([compute_slope_aspect(topo_1ch[i:i+1]) for i in range(topo_1ch.shape[0])], dim=0)

def build_coarse_input(coarse, var_map):
    Hc, Wc = coarse.shape[-2], coarse.shape[-1]
    return torch.cat([coarse, F.adaptive_avg_pool2d(var_map, (Hc, Wc))], dim=1)

# ══════════════════════════════════════════════════════════════════════════════
# 4.  SIGMA_DATA CALCULATOR
# ══════════════════════════════════════════════════════════════════════════════
@torch.no_grad()
def compute_sigma_data(model, dataloader, dev):
    """
    Computes the standard deviation of (HighRes_Precip - Predicted_Mean)
    across the entire dataset to act as SIGMA_DATA for Stage 2.
    """
    print("\n" + "═"*60)
    print("📊 CALCULATING SIGMA_DATA FOR STAGE 2...")
    print("═"*60)
    
    model.eval()
    sum_res = 0.0
    sum_sq_res = 0.0
    n_pixels = 0
    
    for b in dataloader:
        fp       = b["fine"].to(dev, non_blocking=True)[:, PRECIP_CH:PRECIP_CH+1]
        topo_1ch = b["topo"].to(dev, non_blocking=True)
        xi_raw   = b["coarse"].to(dev, non_blocking=True)
        var_map  = b["var_map"].to(dev, non_blocking=True)
        gf       = torch.stack([b["doy"], b["hour"]], 1).float().to(dev, non_blocking=True)
        
        tp = expand_topo(topo_1ch)
        xi = build_coarse_input(xi_raw, var_map)
        
        with autocast(device_type=dev.type):
            mu = model(xi, topo=tp, global_features=gf)
            
        residual = (fp - mu).float() # Compute residual
        
        # Accumulate statistics
        sum_res += residual.sum().item()
        sum_sq_res += (residual ** 2).sum().item()
        n_pixels += residual.numel()

    mean_res = sum_res / n_pixels
    var_res = (sum_sq_res / n_pixels) - (mean_res ** 2)
    sigma_data = math.sqrt(max(var_res, 0))
    
    print(f"Total Pixels Evaluated : {n_pixels:,}")
    print(f"Mean of Residuals      : {mean_res:.6f} (Should be close to 0)")
    print(f"Variance               : {var_res:.6f}")
    print(f"Standard Deviation     : {sigma_data:.6f}\n")
    
    print("🚀 HARDCODE THIS INTO YOUR STAGE 2 SCRIPT:")
    print(f"SIGMA_DATA = {sigma_data:.4f}")
    print("═"*60 + "\n")
    
    return sigma_data

# ══════════════════════════════════════════════════════════════════════════════
# 5.  TRAINING LOOP
# ══════════════════════════════════════════════════════════════════════════════
def train():
    os.makedirs(CKPT_DIR, exist_ok=True)
    dev = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    
    print("Loading SEA Dataset...")
    ds = SEAClimateDataset(
        nc_files_dict={
            "huss": f"{SRGAN_BASE}/HR_DATA_8/huss_rcm_8km_daily_data_1995-2014.nc",
            "mslp": f"{SRGAN_BASE}/HR_DATA_8/mslp_rcm_8km_daily_data_1995-2014.nc",
            "tas":  f"{SRGAN_BASE}/HR_DATA_8/tas_rcm_8km_daily_data_1995-2014.nc",
            "precip": f"{SRGAN_BASE}/HR_DATA_8/precip_rcm_8km_daily_data_1995-2014.nc",
        },
        oro_file=ORO_PATH,
        split='train'
    )
    
    n = len(ds)
    # STRICT 70/10/20 SPLIT
    trn_end = int(0.70 * n)
    val_end = int(0.80 * n)
    
    train_subset = Subset(ds, range(0, trn_end))
    val_subset   = Subset(ds, range(trn_end, val_end))
    test_subset  = Subset(ds, range(val_end, n))
    
    print(f"Dataset Size: {n} | Train: {len(train_subset)} | Val: {len(val_subset)} | Test: {len(test_subset)}")

    trl  = DataLoader(train_subset, BATCH, shuffle=True, num_workers=8, pin_memory=True, drop_last=True)
    val  = DataLoader(val_subset, BATCH, shuffle=False, num_workers=4, pin_memory=True)
    test = DataLoader(test_subset, BATCH, shuffle=False, num_workers=4, pin_memory=True)
    
    # We load sigma stats ONLY on the train subset to prevent data leakage from the test/val sets
    sigma_loader = DataLoader(train_subset, BATCH, shuffle=False, num_workers=8, pin_memory=True)

    model = CorrDiffRegressor(
        in_channels=REG_IN_CH, out_channels=1,
        base_channels=64, channel_mult=(1, 2, 4), num_blocks=2,
        global_dim=GLOBAL_DIM, topo_channels=TOPO_CH
    ).to(dev)

    opt = AdamW(model.parameters(), lr=LR, weight_decay=1e-3)
    scaler = GradScaler(device=dev.type)
    sched = CosineAnnealingWarmRestarts(opt, T_0=30, T_mult=2, eta_min=MIN_LR)
    criterion = nn.L1Loss() # L1 is often more stable for precipitation mean

    best_val_loss = float('inf')
    no_improve = 0
    
    print(f"\nStarting Training. Epochs: {EPOCHS}, Batch: {BATCH}, LR: {LR}")
    print(f"{'Epoch':>5} | {'Train L1':>10} | {'Val L1':>10} | {'Time':>6}")
    print("-" * 40)

    for ep in range(EPOCHS):
        model.train()
        t0 = time.time()
        train_loss = 0.0
        
        for b in trl:
            opt.zero_grad(set_to_none=True)
            
            fp       = b["fine"].to(dev, non_blocking=True)[:, PRECIP_CH:PRECIP_CH+1]
            topo_1ch = b["topo"].to(dev, non_blocking=True)
            xi_raw   = b["coarse"].to(dev, non_blocking=True)
            var_map  = b["var_map"].to(dev, non_blocking=True)
            gf       = torch.stack([b["doy"], b["hour"]], 1).float().to(dev, non_blocking=True)
            
            # Augmentations (flips)
            if torch.rand(1).item() < 0.5:
                fp = fp.flip(-1); topo_1ch = topo_1ch.flip(-1); var_map = var_map.flip(-1)
            if torch.rand(1).item() < 0.5:
                fp = fp.flip(-2); topo_1ch = topo_1ch.flip(-2); var_map = var_map.flip(-2)
                
            tp = expand_topo(topo_1ch)
            xi = build_coarse_input(xi_raw, var_map)
            
            with autocast(device_type=dev.type):
                mu = model(xi, topo=tp, global_features=gf)
                loss = criterion(mu, fp)
                
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            nn.utils.clip_grad_norm_(model.parameters(), GRAD_CLIP)
            scaler.step(opt)
            scaler.update()
            
            train_loss += loss.item()

        sched.step()
        train_loss /= len(trl)
        
        # Validation
        model.eval()
        val_loss = 0.0
        with torch.no_grad():
            for b in val:
                fp       = b["fine"].to(dev, non_blocking=True)[:, PRECIP_CH:PRECIP_CH+1]
                topo_1ch = b["topo"].to(dev, non_blocking=True)
                xi_raw   = b["coarse"].to(dev, non_blocking=True)
                var_map  = b["var_map"].to(dev, non_blocking=True)
                gf       = torch.stack([b["doy"], b["hour"]], 1).float().to(dev, non_blocking=True)
                
                tp = expand_topo(topo_1ch)
                xi = build_coarse_input(xi_raw, var_map)
                
                with autocast(device_type=dev.type):
                    mu = model(xi, topo=tp, global_features=gf)
                    loss = criterion(mu, fp)
                val_loss += loss.item()
                
        val_loss /= len(val)
        el = time.time() - t0
        
        star = ""
        if val_loss < best_val_loss:
            best_val_loss = val_loss
            no_improve = 0
            star = "★"
            torch.save({"epoch": ep, "model_state_dict": model.state_dict()}, SAVE_PATH)
        else:
            no_improve += 1
            
        print(f"{ep:>5} | {train_loss:>10.5f} | {val_loss:>10.5f} | {el:>5.1f}s {star}")
        
        if no_improve >= PATIENCE:
            print(f"Early stopping triggered at epoch {ep}")
            break

    # ══════════════════════════════════════════════════════════════════════════
    # POST-TRAINING: CALCULATE SIGMA_DATA
    # ══════════════════════════════════════════════════════════════════════════
    print("\nLoading best model weights for SIGMA_DATA calculation...")
    model.load_state_dict(torch.load(SAVE_PATH, map_location=dev)["model_state_dict"])
    
    # Calculate across the TRAIN dataloader strictly (prevents test set leakage)
    compute_sigma_data(model, sigma_loader, dev)

if __name__ == "__main__":
    train()
