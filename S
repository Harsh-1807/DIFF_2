# 6.  TEMPORAL CONDITIONING (SEA Specific: Flatten Multi-Var)
# ══════════════════════════════════════════════════════════════════════════════
def build_temporal_cond(batch, dev):
    """
    Takes [B, T_COND, C, Hc, Wc], flattens T & C to [B, T_COND*C, Hc, Wc],
    and interpolates to high-res.
    """
    target_shape = batch["fine"].shape[-2:]
    tc = batch["tc_frames"].to(dev, non_blocking=True)
    
    if tc.dim() == 5:
        B, T_c, C, Hc, Wc = tc.shape
        tc = tc.view(B, T_c * C, Hc, Wc)
        
    return F.interpolate(tc, size=target_shape, mode='nearest')

