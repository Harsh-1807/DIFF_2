# 7.  V5 SINGAPORE LOSS & METRICS
# ══════════════════════════════════════════════════════════════════════════════
def v5_singapore_loss(pred, target, sigma):
    # 1. Base Min-SNR L1
    snr = (SIGMA_DATA ** 2) / (sigma ** 2 + 1e-6)
    w = torch.clamp(snr, max=5.0)
    base_loss = (torch.abs(pred - target) * w).mean()
    
    # 2. High Freq
    P = torch.fft.rfft2(pred.float()).abs()
    T = torch.fft.rfft2(target.float()).abs()
    hf_loss = torch.abs(P[..., -P.shape[-1]//2:] - T[..., -T.shape[-1]//2:]).mean()
    
    # 3. Sobel Edge
    kx = torch.tensor([[-1,0,1],[-2,0,2],[-1,0,1]], device=pred.device).view(1,1,3,3).float()
    ky = torch.tensor([[-1,-2,-1],[0,0,0],[1,2,1]], device=pred.device).view(1,1,3,3).float()
    gx_p = F.conv2d(pred, kx, padding=1); gy_p = F.conv2d(pred, ky, padding=1)
    gx_t = F.conv2d(target, kx, padding=1); gy_t = F.conv2d(target, ky, padding=1)
    grad_p = torch.sqrt(gx_p**2 + gy_p**2 + 1e-8)
    grad_t = torch.sqrt(gx_t**2 + gy_t**2 + 1e-8)
    sobel_loss = torch.abs(grad_p - grad_t).mean()
    
    # 4. Bridge-Killer Sparsity (Force dry regions to be dry)
    bridge_killer = torch.mean(torch.abs(pred) * (target < 1e-4).float())
    
    # 5. Nuclear PCC Push (Differentiable)
    pred_m = pred - pred.mean(dim=[-1, -2], keepdim=True)
    targ_m = target - target.mean(dim=[-1, -2], keepdim=True)
    cov = (pred_m * targ_m).sum(dim=[-1, -2])
    var_p = (pred_m**2).sum(dim=[-1, -2])
    var_t = (targ_m**2).sum(dim=[-1, -2])
    pcc = cov / (torch.sqrt(var_p * var_t) + 1e-8)
    nuclear_pcc = (1.0 - pcc).mean()

    return base_loss + (3.0 * hf_loss) + (0.8 * sobel_loss) + (2.0 * bridge_killer) + (1.5 * nuclear_pcc)

@torch.no_grad()
def weighted_pcc(pred, target, lat_w=None):
    B = pred.shape[0]
    p = pred.float().view(B, -1); t = target.float().view(B, -1)
    pm = p.mean(dim=1, keepdim=True); tm = t.mean(dim=1, keepdim=True)
    pm_c = p - pm; tm_c = t - tm
    p_l2 = torch.sqrt((pm_c**2).sum(dim=1))
    t_l2 = torch.sqrt((tm_c**2).sum(dim=1))
    r = (pm_c * tm_c).sum(dim=1) / (p_l2 * t_l2 + 1e-8)
    return r.mean().item()

@torch.no_grad()
def fractions_skill_score(pred, target, threshold=0.5, window=5):
    p_bin = (pred > threshold).float()
    t_bin = (target > threshold).float()
    p_frac = F.avg_pool2d(p_bin, kernel_size=window, stride=1, padding=window//2)
    t_frac = F.avg_pool2d(t_bin, kernel_size=window, stride=1, padding=window//2)
    mse = ((p_frac - t_frac)**2).mean(dim=[-1, -2])
    ref = (p_frac**2).mean(dim=[-1, -2]) + (t_frac**2).mean(dim=[-1, -2])
    fss = 1.0 - mse / (ref + 1e-8)
    return fss.mean().item()

